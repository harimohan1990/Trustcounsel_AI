# TrustCounsel AI Environment Configuration Example
# Copy to .env for local overrides

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="TrustCounsel AI"
API_PORT=8000
WEB_PORT=5173

# Security & Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_256_bit_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL + pgvector)
# For local Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/trustcounsel_db
# For SQLite test fallback: sqlite+aiosqlite:///./data/trustcounsel_dev.db
DATABASE_URL=sqlite+aiosqlite:///./data/trustcounsel_dev.db
DATABASE_ECHO=false

# Redis (Cache, Tasks, Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=52428800 # 50MB

# AI Provider Configuration
# Supported: "mock", "openai", "anthropic", "ollama"
MODEL_PROVIDER=mock
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=384

# Hosted Provider Credentials (Optional; not needed in mock mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Evaluation & Observability
ENABLE_OPENTELEMETRY=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
